# Dependencies & virtual environments
.venv/
venv/
env/
node_modules/

# Python cache & build outputs
__pycache__/
*.pyc
*.pyo
*.pyd
build/
dist/
*.egg-info/

# Version control internals
.git/

# Package lock files (avoids flooding AI context with thousands of lines)
uv.lock
package-lock.json
pnpm-lock.yaml

# Testing & coverage artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/

# Sensitive configuration & keys
.env
.env.*
*.pem
*.key

# Temporary files & AI scratch directories
tmp/
temp/
.artifacts/
.gemini/scratch/
.antigravity/scratch/
